# QSS Stilini Uygulama
        self.setStyleSheet("""
            /* Ana Pencere Arka Planı ve Kenarlıkları */
            QDialog {
                background-color: #2b2b2b;
                border: 1px solid #444444;
                border-radius: 8px;
            }

            /* Pencere içindeki metinler (Başlık veya içerik) */
            QLabel {
                color: #e0e0e0;
                font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
                font-size: 14px;
            }

            /* Genel Buton Tasarımı */
            QPushButton {
                font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
                font-size: 13px;
                font-weight: bold;
                color: #ffffff;
                border-radius: 5px;
                padding: 6px 16px;
                outline: none; /* Odaklanma çizgisini kaldırır */
            }

            /* Onay Butonu (Yeşil Tonları) */
            QPushButton#yesButton {
                background-color: #4CAF50;
                border: 1px solid #388E3C;
            }
            QPushButton#yesButton:hover {
                background-color: #45a049;
            }
            QPushButton#yesButton:pressed {
                background-color: #3e8e41;
            }

            /* Ret Butonu (Kırmızı Tonları) */
            QPushButton#noButton {
                background-color: #e53935;
                border: 1px solid #c62828;
            }
            QPushButton#noButton:hover {
                background-color: #d32f2f;
            }
            QPushButton#noButton:pressed {
                background-color: #b71c1c;
            }
        """)