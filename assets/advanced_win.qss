/* Ana Pencere ve Genel Yapı */
QWidget {
    background-color: #18181b; /* Daha derin, tok bir antrasit */
    color: #e4e4e7;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
}

/* ========================================= */
/* KAYMA SORUNUNU ÇÖZEN KISIM                */
/* ========================================= */
QLabel {
    font-weight: 500;
    color: #a1a1aa;
    background: transparent;
    margin: 0px; /* Fazladan itilmeyi engeller */
    padding: 0px;
}

QGroupBox {
    border: 1px solid #3f3f46;
    border-radius: 10px;
    margin-top: 24px;   /* Başlığın dışarı taşması için yer açar */
    padding-top: 16px;  /* İçerikteki ilk elemanın çizgiden uzaklığı */
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 0px; /* Negatif değerleri sıfırlayarak düzenin bozulmasını engelledik */
    background-color: #18181b; /* Arka planı kesip net görünmesi için ana renk */
    padding: 2px 8px;
    color: #8b5cf6; /* Canlı Mor Accent */
    font-weight: bold;
    font-size: 13px;
    border-radius: 4px;
}

/* ========================================= */
/* RENKLENDİRİLMİŞ MODERN BİLEŞENLER         */
/* ========================================= */

/* Sekme (Tab) Sistemi */
QTabWidget::pane {
    border: none; /* Çerçeveyi kaldırıp sekmeleri daha özgür bıraktık */
    background-color: transparent;
    margin-top: 4px;
}

QTabBar::tab {
    background-color: #27272a;
    color: #a1a1aa;
    padding: 8px 24px;
    margin: 0px 4px;
    border-radius: 8px;
    font-weight: bold;
}

/* Seçili sekmeye renkli gradyan efekti */
QTabBar::tab:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6366f1, stop:1 #8b5cf6); /* İndigo'dan Mora */
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #3f3f46;
    color: #ffffff;
}

/* Açılır Menüler (ComboBox) */
QComboBox {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 6px 12px;
    min-width: 100px;
    color: #ffffff;
}

QComboBox:hover {
    border: 1px solid #6366f1; /* Hover durumunda İndigo parlaması */
    background-color: #3f3f46;
}

QComboBox:focus {
    border: 2px solid #8b5cf6; /* Seçilince Mor çerçeve */
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #27272a;
    border: 1px solid #8b5cf6;
    border-radius: 8px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: none;
}

/* Onay Kutuları (CheckBox) */
QCheckBox {
    spacing: 10px;
    color: #e4e4e7;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3f3f46;
    border-radius: 6px; /* Daha tatlı köşeler */
    background-color: #18181b;
}

QCheckBox::indicator:hover {
    border-color: #6366f1;
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border-color: #6366f1;
}

/* Kaydırıcı (Slider) - Canlı Gradyan */
QSlider::groove:horizontal {
    border-radius: 3px;
    height: 6px;
    background: #3f3f46;
}

QSlider::sub-page:horizontal {
    /* Mavi'den Cyan'a (Turkuaz) geçiş yapan dolgu */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #06b6d4); 
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 2px solid #06b6d4;
}

QSlider::handle:horizontal:hover {
    background: #f8fafc;
    border: 3px solid #3b82f6;
    width: 18px;
    height: 18px;
    margin: -6px 0; /* Üstüne gelince hafif büyüme efekti */
}

/* Metin Kutusu (QLineEdit) */
QLineEdit {
    background-color: #18181b;
    border: 2px solid #27272a;
    border-radius: 8px;
    padding: 8px 12px;
    color: #10b981; /* Yazılan metin zümrüt yeşili olacak, dikkat çeker */
    font-weight: bold;
}

QLineEdit:focus {
    border: 2px solid #6366f1;
}

QLineEdit:read-only {
    background-color: #18181b;
    color: #a1a1aa;
    border: 2px dashed #3f3f46; /* Salt okunur olduğu netleşir */
    font-weight: normal;
}